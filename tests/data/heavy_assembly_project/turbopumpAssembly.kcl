turbineFrontSketch = sketch(on = offsetPlane(YZ, offset = 330mm)) {
  shell = circle(start = [var 455mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 910mm
}
turbineMidSketch = sketch(on = offsetPlane(YZ, offset = 610mm)) {
  shell = circle(start = [var 385mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 770mm
}
turbineRearSketch = sketch(on = offsetPlane(YZ, offset = 890mm)) {
  shell = circle(start = [var 325mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 650mm
}
turbineFrontRegion = region(segments = [turbineFrontSketch.shell])
turbineMidRegion = region(segments = [turbineMidSketch.shell])
turbineRearRegion = region(segments = [turbineRearSketch.shell])
turbineHousing = loft(
  [
    turbineFrontRegion,
    turbineMidRegion,
    turbineRearRegion
  ],
  vDegree = 2,
)
  |> appearance(color = "#3f4447", metalness = 85, roughness = 34)
