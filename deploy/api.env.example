# Add to the existing API deployment. Use the same resource and service secret
# as the MCP deployment. No new public domain or ingress is required.
ZOO_MCP_RESOURCE=https://api.zoo.dev/mcp
ZOO_API_AUDIENCE=https://api.zoo.dev
ZOO_MCP_UPSTREAM=http://zoo-mcp:8080
# ZOO_MCP_SERVICE_SECRET comes from the shared Vault/Kubernetes secret.
# Add the exact Claude and Codex CIMD URLs supplied during catalog setup.
ZOO_MCP_CLIENT_METADATA_URLS=https://chatgpt.com/oauth/client.json
