// F-1 gas generator assembly
// Compact gas generator with dual propellant valves, turbine feed, mounts, and service hardware.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock, unitCylinderX, unitCylinderY, unitCylinderZ, unitRingX, unitRingY, unitRingZ from "primitives.kcl"

generatorRearSketch = sketch(on = offsetPlane(XZ, offset = -360mm)) {
  shell = circle(start = [var 210mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 420mm
}
generatorLowSketch = sketch(on = offsetPlane(XZ, offset = -210mm)) {
  shell = circle(start = [var 270mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 540mm
}
generatorMidSketch = sketch(on = offsetPlane(XZ, offset = 80mm)) {
  shell = circle(start = [var 300mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 600mm
}
generatorFrontSketch = sketch(on = offsetPlane(XZ, offset = 260mm)) {
  shell = circle(start = [var 205mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([shell.center, ORIGIN])
  horizontal([shell.center, shell.start])
  diameter(shell) == 410mm
}
generatorRearRegion = region(segments = [generatorRearSketch.shell])
generatorLowRegion = region(segments = [generatorLowSketch.shell])
generatorMidRegion = region(segments = [generatorMidSketch.shell])
generatorFrontRegion = region(segments = [generatorFrontSketch.shell])
generatorChamber = loft(
  [
    generatorRearRegion,
    generatorLowRegion,
    generatorMidRegion,
    generatorFrontRegion
  ],
  vDegree = 3,
)
  |> appearance(color = "#625342", metalness = 78, roughness = 42)

generatorRearBand = clone(unitRingY)
  |> scale(
       x = 610,
       y = 70,
       z = 610,
       global = true,
     )
  |> translate(y = -225mm, global = true)
  |> appearance(color = "#9d8468", metalness = 82, roughness = 35)
generatorMidBand = clone(unitRingY)
  |> scale(
       x = 650,
       y = 62,
       z = 650,
       global = true,
     )
  |> translate(y = 55mm, global = true)
  |> appearance(color = "#8a735d", metalness = 81, roughness = 37)
generatorFrontBand = clone(unitRingY)
  |> scale(
       x = 520,
       y = 75,
       z = 520,
       global = true,
     )
  |> translate(y = 245mm, global = true)
  |> appearance(color = "#a18a70", metalness = 83, roughness = 34)

injectorHousing = clone(unitCylinderY)
  |> scale(
       x = 500,
       y = 170,
       z = 500,
       global = true,
     )
  |> translate(y = -440mm, global = true)
  |> appearance(color = "#777f82", metalness = 86, roughness = 31)
injectorFlange = clone(unitRingY)
  |> scale(
       x = 640,
       y = 82,
       z = 640,
       global = true,
     )
  |> translate(y = -535mm, global = true)
  |> appearance(color = "#b4b9ba", metalness = 90, roughness = 25)
injectorCover = clone(unitCylinderY)
  |> scale(
       x = 410,
       y = 62,
       z = 410,
       global = true,
     )
  |> translate(y = -600mm, global = true)
  |> appearance(color = "#555d61", metalness = 83, roughness = 36)

loxValveHousing = clone(unitCylinderZ)
  |> scale(
       x = 270,
       y = 270,
       z = 230,
       global = true,
     )
  |> translate(
       x = -185mm,
       y = -300mm,
       z = 295mm,
       global = true,
     )
  |> appearance(color = "#8b9497", metalness = 87, roughness = 29)
fuelValveHousing = clone(loxValveHousing)
  |> translate(x = 370mm, global = true)
  |> appearance(color = "#9b7655", metalness = 79, roughness = 39)
loxValveCap = clone(unitCylinderZ)
  |> scale(
       x = 330,
       y = 330,
       z = 72,
       global = true,
     )
  |> translate(
       x = -185mm,
       y = -300mm,
       z = 442mm,
       global = true,
     )
  |> appearance(color = "#b3b9bb", metalness = 90, roughness = 25)
fuelValveCap = clone(loxValveCap)
  |> translate(x = 370mm, global = true)
  |> appearance(color = "#b29a7d", metalness = 84, roughness = 32)
valveBridge = clone(unitCylinderX)
  |> scale(
       x = 430,
       y = 135,
       z = 135,
       global = true,
     )
  |> translate(y = -300mm, z = 330mm, global = true)
  |> appearance(color = "#697176", metalness = 85, roughness = 33)
loxValveDrop = clone(unitCylinderZ)
  |> scale(
       x = 115,
       y = 115,
       z = 270,
       global = true,
     )
  |> translate(
       x = -185mm,
       y = -255mm,
       z = 155mm,
       global = true,
     )
  |> appearance(color = "#8c9598", metalness = 87, roughness = 30)
fuelValveDrop = clone(loxValveDrop)
  |> translate(x = 370mm, global = true)
  |> appearance(color = "#9d7958", metalness = 79, roughness = 39)

