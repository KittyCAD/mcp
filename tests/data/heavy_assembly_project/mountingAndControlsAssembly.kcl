mountRingBolts = patternCircular3d(
  mountBoltSeed,
  instances = 20,
  axis = Z,
  center = [0mm, 0mm, 315mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)

instrumentConduitProfileSketchHidden = hide(instrumentConduitProfileSketch)
instrumentConduitPathSketchHidden = hide(instrumentConduitPathSketch)

