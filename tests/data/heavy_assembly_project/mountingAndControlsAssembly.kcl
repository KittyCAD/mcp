instrumentConduitProfileSketch = sketch(on = XY) {
  cable = circle(start = [var 14mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([cable.center, ORIGIN])
  horizontal([cable.center, cable.start])
  diameter(cable) == 28mm
}
instrumentConduitProfile = region(segments = [instrumentConduitProfileSketch.cable])
instrumentConduitPathSketch = sketch(on = offsetPlane(XZ, offset = -645mm)) {
  sensorRise = line(start = [var 410mm, var -390mm], end = [var 410mm, var -120mm])
  serviceElbow = arc(start = [var 410mm, var -120mm], end = [var 620mm, var 90mm], center = [var 620mm, var -120mm])
  junctionRun = line(start = [var 620mm, var 90mm], end = [var 900mm, var 90mm])
  coincident([sensorRise.end, serviceElbow.start])
  coincident([serviceElbow.end, junctionRun.start])
  tangent([sensorRise, serviceElbow])
  tangent([serviceElbow, junctionRun])
  vertical(sensorRise)
  horizontal(junctionRun)
  horizontalDistance([ORIGIN, sensorRise.start]) == 410mm
  verticalDistance([ORIGIN, sensorRise.start]) == -390mm
  distance([sensorRise.start, sensorRise.end]) == 270mm
  horizontalDistance([ORIGIN, serviceElbow.center]) == 620mm
  verticalDistance([ORIGIN, serviceElbow.center]) == -120mm
  horizontalDistance([ORIGIN, serviceElbow.end]) == 620mm
  verticalDistance([ORIGIN, serviceElbow.end]) == 90mm
  distance([junctionRun.start, junctionRun.end]) == 280mm
}
instrumentConduitPrimary = sweep(
  instrumentConduitProfile,
  path = [
    instrumentConduitPathSketch.sensorRise,
    instrumentConduitPathSketch.serviceElbow,
    instrumentConduitPathSketch.junctionRun
  ],
  translateProfileToPath = true,
  orientProfilePerpendicular = true,
  version = 2,
)
  |> appearance(color = "#697378", metalness = 84, roughness = 35)
instrumentConduitSecondary = clone(instrumentConduitPrimary)
  |> translate(y = 38mm, global = true)
instrumentConduitTertiary = clone(instrumentConduitPrimary)
  |> translate(y = 76mm, global = true)

