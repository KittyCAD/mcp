fuelDischargePathBSketchHidden = hide(fuelDischargePathBSketch)

export propellantDuctAssembly = flatten([
  loxFeedDuct,
  loxFeedReducer,
  loxExternalFlange,
  loxVerticalClampLower,
  loxVerticalClampUpper,
  loxFeedBellows,
  loxSupportFoot,
  loxSupportWeb,
  loxTransferClamp,
  loxTransferBolts,
  fuelFeedDuct,
  fuelFeedReducer,
  fuelExternalFlange,
  fuelFeedBellows,
  fuelFeedClamp,
  fuelDischargeDuctA,
  fuelDischargeDuctB,
  fuelCrossoverBellows,
  fuelLowerClamp,
  fuelUpperClamp,
  fuelManifoldClamp,
  fuelPipeSupportA,
  fuelPipeSupportWebA,
  fuelPipeSupportB,
  fuelPipeSupportWebB,
  loxInterfaceBolts,
  fuelInterfaceBolts,
  fuelManifoldBolts
])
