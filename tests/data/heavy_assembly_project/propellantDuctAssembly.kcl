// F-1 propellant duct assembly
// Routed LOX and RP-1 feed and discharge plumbing with smooth elbows, reducers, bellows, clamps, and bolted interfaces.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock, unitCylinderX, unitCylinderY, unitCylinderZ, unitRingX, unitRingY, unitRingZ from "primitives.kcl"

loxFeedProfileSketch = sketch(on = XY) {
  tube = circle(start = [var 230mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([tube.center, ORIGIN])
  horizontal([tube.center, tube.start])
  diameter(tube) == 460mm
}
loxFeedProfile = region(segments = [loxFeedProfileSketch.tube])
loxFeedPathSketch = sketch(on = offsetPlane(XZ, offset = 170mm)) {
  rise = line(start = [var -585mm, var 795mm], end = [var -585mm, var 1175mm])
  upperElbow = arc(start = [var -585mm, var 1175mm], end = [var -885mm, var 1475mm], center = [var -885mm, var 1175mm])
  interfaceRun = line(start = [var -885mm, var 1475mm], end = [var -1200mm, var 1475mm])
  coincident([rise.end, upperElbow.start])
  coincident([upperElbow.end, interfaceRun.start])
  tangent([rise, upperElbow])
  tangent([upperElbow, interfaceRun])
  vertical(rise)
  horizontal(interfaceRun)
  horizontalDistance([ORIGIN, rise.start]) == -585mm
  verticalDistance([ORIGIN, rise.start]) == 795mm
  distance([rise.start, rise.end]) == 380mm
  horizontalDistance([ORIGIN, upperElbow.center]) == -885mm
  verticalDistance([ORIGIN, upperElbow.center]) == 1175mm
  horizontalDistance([ORIGIN, upperElbow.end]) == -885mm
  verticalDistance([ORIGIN, upperElbow.end]) == 1475mm
  distance([interfaceRun.start, interfaceRun.end]) == 315mm
}
loxFeedDuct = sweep(
  loxFeedProfile,
  path = [
    loxFeedPathSketch.rise,
    loxFeedPathSketch.upperElbow,
    loxFeedPathSketch.interfaceRun
  ],
  translateProfileToPath = true,
  orientProfilePerpendicular = true,
  version = 2,
)
  |> appearance(color = "#9aa3a7", metalness = 88, roughness = 30)

loxReducerStartSketch = sketch(on = offsetPlane(YZ, offset = -1200mm)) {
  section = circle(start = [var 60mm, var 1475mm], center = [var -170mm, var 1475mm])
  horizontal([section.center, section.start])
  horizontalDistance([ORIGIN, section.center]) == -170mm
  verticalDistance([ORIGIN, section.center]) == 1475mm
  diameter(section) == 460mm
}
loxReducerMidSketch = sketch(on = offsetPlane(YZ, offset = -1320mm)) {
  section = circle(start = [var 100mm, var 1475mm], center = [var -170mm, var 1475mm])
  horizontal([section.center, section.start])
  horizontalDistance([ORIGIN, section.center]) == -170mm
  verticalDistance([ORIGIN, section.center]) == 1475mm
  diameter(section) == 540mm
}
loxReducerEndSketch = sketch(on = offsetPlane(YZ, offset = -1440mm)) {
  section = circle(start = [var 140mm, var 1475mm], center = [var -170mm, var 1475mm])
  horizontal([section.center, section.start])
  horizontalDistance([ORIGIN, section.center]) == -170mm
  verticalDistance([ORIGIN, section.center]) == 1475mm
  diameter(section) == 620mm
}
loxReducerStartRegion = region(segments = [loxReducerStartSketch.section])
loxReducerMidRegion = region(segments = [loxReducerMidSketch.section])
loxReducerEndRegion = region(segments = [loxReducerEndSketch.section])
loxFeedReducer = loft(
  [
    loxReducerStartRegion,
    loxReducerMidRegion,
    loxReducerEndRegion
  ],
  vDegree = 2,
)
  |> appearance(color = "#a8b0b3", metalness = 89, roughness = 28)
loxExternalFlange = clone(unitRingX)
  |> scale(
       x = 105,
       y = 760,
       z = 760,
       global = true,
     )
  |> translate(
       x = -1490mm,
       y = -170mm,
       z = 1475mm,
       global = true,
     )
  |> appearance(color = "#c1c6c8", metalness = 92, roughness = 22)

loxVerticalClampLower = clone(unitRingZ)
  |> scale(
       x = 550,
       y = 550,
       z = 55,
       global = true,
     )
  |> translate(
       x = -585mm,
       y = -170mm,
       z = 965mm,
       global = true,
     )
  |> appearance(color = "#626b70", metalness = 84, roughness = 34)
loxVerticalClampUpper = clone(loxVerticalClampLower)
  |> translate(z = 165mm, global = true)
loxBellowsSeed = clone(unitRingX)
  |> scale(
       x = 32,
       y = 535,
       z = 535,
       global = true,
     )
  |> translate(
       x = -930mm,
       y = -170mm,
