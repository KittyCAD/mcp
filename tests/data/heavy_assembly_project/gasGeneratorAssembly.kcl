  |> appearance(color = "#adb3b5", metalness = 90, roughness = 25)
igniterCapLower = clone(igniterCapUpper)
  |> translate(z = -290mm, global = true)

generatorOutletBoss = clone(unitCylinderZ)
  |> scale(
       x = 300,
       y = 300,
       z = 240,
       global = true,
     )
  |> translate(y = -150mm, z = -300mm, global = true)
  |> appearance(color = "#57483c", metalness = 74, roughness = 46)
generatorOutletFlange = clone(unitRingZ)
  |> scale(
       x = 430,
       y = 430,
       z = 78,
       global = true,
     )
  |> translate(y = -150mm, z = -405mm, global = true)
  |> appearance(color = "#9d8269", metalness = 80, roughness = 37)

hotGasProfileSketch = sketch(on = XY) {
  tube = circle(start = [var 145mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([tube.center, ORIGIN])
  horizontal([tube.center, tube.start])
  diameter(tube) == 290mm
}
hotGasProfile = region(segments = [hotGasProfileSketch.tube])
hotGasPathSketch = sketch(on = YZ) {
  turbineDrop = line(start = [var -150mm, var -405mm], end = [var -150mm, var -580mm])
  vertical(turbineDrop)
  horizontalDistance([ORIGIN, turbineDrop.start]) == -150mm
  verticalDistance([ORIGIN, turbineDrop.start]) == -405mm
  distance([turbineDrop.start, turbineDrop.end]) == 175mm
}
hotGasTransferDuct = sweep(
  hotGasProfile,
  path = [hotGasPathSketch.turbineDrop],
  translateProfileToPath = true,
  orientProfilePerpendicular = true,
  version = 2,
)
  |> appearance(color = "#685548", metalness = 75, roughness = 43)
turbineFeedFlange = clone(unitRingZ)
  |> scale(
       x = 450,
       y = 450,
       z = 80,
       global = true,
     )
  |> translate(y = -150mm, z = -580mm, global = true)
  |> appearance(color = "#a88d71", metalness = 81, roughness = 36)
hotGasBellowsSeed = clone(unitRingZ)
  |> scale(
       x = 355,
       y = 355,
       z = 28,
       global = true,
     )
  |> translate(y = -150mm, z = -455mm, global = true)
  |> appearance(color = "#7d7167", metalness = 78, roughness = 40)
hotGasBellows = patternLinear3d(
  hotGasBellowsSeed,
  instances = 4,
  distance = -34mm,
  axis = Z,
)

leftMountFoot = clone(unitBlock)
  |> scale(
       x = 180,
       y = 470,
       z = 115,
       global = true,
     )
  |> translate(
       x = -225mm,
       y = -45mm,
       z = -355mm,
       global = true,
     )
  |> appearance(color = "#3f464a", metalness = 79, roughness = 41)
rightMountFoot = clone(leftMountFoot)
  |> translate(x = 450mm, global = true)
leftMountWeb = clone(unitBlock)
  |> scale(
       x = 105,
       y = 300,
       z = 270,
       global = true,
     )
  |> rotate(axis = Y, angle = -18deg, global = true)
  |> translate(
       x = -205mm,
       y = -45mm,
       z = -245mm,
       global = true,
     )
  |> appearance(color = "#4a5256", metalness = 80, roughness = 39)
rightMountWeb = clone(leftMountWeb)
  |> rotate(axis = Z, angle = 180deg, global = true)

controlJunctionBox = clone(unitBlock)
  |> scale(
       x = 150,
       y = 235,
       z = 205,
       global = true,
     )
  |> translate(
       x = -340mm,
       y = -25mm,
       z = 55mm,
       global = true,
     )
  |> appearance(color = "#30363a", metalness = 70, roughness = 51)
controlJunctionCover = clone(unitBlock)
  |> scale(
       x = 38,
       y = 175,
       z = 155,
       global = true,
     )
  |> translate(
       x = -434mm,
       y = -25mm,
       z = 55mm,
       global = true,
     )
  |> appearance(color = "#747c80", metalness = 85, roughness = 32)
controlConnectorUpper = clone(unitCylinderX)
  |> scale(
       x = 90,
       y = 52,
       z = 52,
       global = true,
     )
  |> translate(
       x = -455mm,
       y = -70mm,
       z = 105mm,
       global = true,
     )
  |> appearance(color = "#9ba2a5", metalness = 87, roughness = 29)
controlConnectorLower = clone(controlConnectorUpper)
  |> translate(y = 95mm, z = -95mm, global = true)

rearBoltSeed = clone(unitCylinderY)
  |> scale(
       x = 46,
       y = 72,
       z = 46,
       global = true,
     )
  |> translate(x = 270mm, y = -575mm, global = true)
  |> appearance(color = "#c5c9ca", metalness = 93, roughness = 19)
rearFlangeBolts = patternCircular3d(
  rearBoltSeed,
  instances = 12,
  axis = Y,
  center = [0mm, -575mm, 0mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
outletBoltSeed = clone(unitCylinderZ)
  |> scale(
       x = 38,
       y = 38,
       z = 68,
       global = true,
     )
  |> translate(
       x = 182mm,
       y = -150mm,
       z = -405mm,
       global = true,
     )
  |> appearance(color = "#c3c7c8", metalness = 92, roughness = 20)
outletFlangeBolts = patternCircular3d(
  outletBoltSeed,
  instances = 10,
  axis = Z,
  center = [0mm, -150mm, -405mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)

generatorRearSketchHidden = hide(generatorRearSketch)
generatorLowSketchHidden = hide(generatorLowSketch)
generatorMidSketchHidden = hide(generatorMidSketch)
generatorFrontSketchHidden = hide(generatorFrontSketch)
hotGasProfileSketchHidden = hide(hotGasProfileSketch)
hotGasPathSketchHidden = hide(hotGasPathSketch)

export gasGeneratorAssembly = flatten([
  generatorChamber,
  generatorRearBand,
  generatorMidBand,
  generatorFrontBand,
  injectorHousing,
  injectorFlange,
  injectorCover,
  loxValveHousing,
  fuelValveHousing,
  loxValveCap,
  fuelValveCap,
  valveBridge,
  loxValveDrop,
  fuelValveDrop,
  loxServiceBoss,
  loxServiceFlange,
  fuelServiceBoss,
  fuelServiceFlange,
  igniterBossUpper,
  igniterBossLower,
  igniterCapUpper,
  igniterCapLower,
  generatorOutletBoss,
  generatorOutletFlange,
  hotGasTransferDuct,
  turbineFeedFlange,
  hotGasBellows,
  leftMountFoot,
  rightMountFoot,
  leftMountWeb,
  rightMountWeb,
  controlJunctionBox,
  controlJunctionCover,
  controlConnectorUpper,
  controlConnectorLower,
  rearFlangeBolts,
  outletFlangeBolts
])
