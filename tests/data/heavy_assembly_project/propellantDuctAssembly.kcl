fuelFeedProfileSketch = sketch(on = XY) {
  tube = circle(start = [var 180mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([tube.center, ORIGIN])
  horizontal([tube.center, tube.start])
  diameter(tube) == 360mm
}
fuelFeedProfile = region(segments = [fuelFeedProfileSketch.tube])
fuelFeedPathSketch = sketch(on = offsetPlane(YZ, offset = -40mm)) {
  lowerRun = line(start = [var -815mm, var 120mm], end = [var -1120mm, var 120mm])
  feedElbow = arc(start = [var -1120mm, var 120mm], end = [var -1370mm, var 370mm], center = [var -1120mm, var 370mm])
  riser = line(start = [var -1370mm, var 370mm], end = [var -1370mm, var 950mm])
  coincident([lowerRun.end, feedElbow.start])
  coincident([feedElbow.end, riser.start])
  tangent([lowerRun, feedElbow])
  tangent([feedElbow, riser])
  horizontal(lowerRun)
  vertical(riser)
  horizontalDistance([ORIGIN, lowerRun.start]) == -815mm
  verticalDistance([ORIGIN, lowerRun.start]) == 120mm
  distance([lowerRun.start, lowerRun.end]) == 305mm
  horizontalDistance([ORIGIN, feedElbow.center]) == -1120mm
  verticalDistance([ORIGIN, feedElbow.center]) == 370mm
  horizontalDistance([ORIGIN, feedElbow.end]) == -1370mm
  verticalDistance([ORIGIN, feedElbow.end]) == 370mm
  distance([riser.start, riser.end]) == 580mm
}
fuelFeedDuct = sweep(
  fuelFeedProfile,
  path = [
    fuelFeedPathSketch.lowerRun,
    fuelFeedPathSketch.feedElbow,
    fuelFeedPathSketch.riser
  ],
  translateProfileToPath = true,
  orientProfilePerpendicular = true,
  version = 2,
)
  |> appearance(color = "#aab1b3", metalness = 89, roughness = 28)

fuelReducerStartSketch = sketch(on = offsetPlane(XY, offset = 950mm)) {
  section = circle(start = [var 140mm, var -1370mm], center = [var -40mm, var -1370mm])
  horizontal([section.center, section.start])
  horizontalDistance([ORIGIN, section.center]) == -40mm
  verticalDistance([ORIGIN, section.center]) == -1370mm
  diameter(section) == 360mm
}
fuelReducerMidSketch = sketch(on = offsetPlane(XY, offset = 1050mm)) {
  section = circle(start = [var 170mm, var -1370mm], center = [var -40mm, var -1370mm])
  horizontal([section.center, section.start])
  horizontalDistance([ORIGIN, section.center]) == -40mm
  verticalDistance([ORIGIN, section.center]) == -1370mm
  diameter(section) == 420mm
}
fuelReducerEndSketch = sketch(on = offsetPlane(XY, offset = 1150mm)) {
  section = circle(start = [var 195mm, var -1370mm], center = [var -40mm, var -1370mm])
  horizontal([section.center, section.start])
  horizontalDistance([ORIGIN, section.center]) == -40mm
  verticalDistance([ORIGIN, section.center]) == -1370mm
  diameter(section) == 470mm
}
fuelReducerStartRegion = region(segments = [fuelReducerStartSketch.section])
fuelReducerMidRegion = region(segments = [fuelReducerMidSketch.section])
fuelReducerEndRegion = region(segments = [fuelReducerEndSketch.section])
fuelFeedReducer = loft(
  [
    fuelReducerStartRegion,
    fuelReducerMidRegion,
    fuelReducerEndRegion
  ],
  vDegree = 2,
)
  |> appearance(color = "#b2b8ba", metalness = 89, roughness = 27)
fuelExternalFlange = clone(unitRingZ)
  |> scale(
       x = 590,
       y = 590,
       z = 95,
       global = true,
     )
  |> translate(
       x = -40mm,
       y = -1370mm,
       z = 1205mm,
       global = true,
     )
  |> appearance(color = "#c6cacc", metalness = 92, roughness = 21)
fuelBellowsSeed = clone(unitRingZ)
  |> scale(
       x = 430,
       y = 430,
       z = 30,
       global = true,
     )
  |> translate(
       x = -40mm,
       y = -1370mm,
       z = 650mm,
       global = true,
     )
  |> appearance(color = "#959da0", metalness = 87, roughness = 31)
fuelFeedBellows = patternLinear3d(
  fuelBellowsSeed,
  instances = 6,
  distance = 42mm,
  axis = Z,
)
fuelFeedClamp = clone(unitRingY)
  |> scale(
       x = 445,
       y = 55,
       z = 445,
       global = true,
     )
  |> translate(
       x = -40mm,
       y = -1020mm,
       z = 120mm,
       global = true,
     )
  |> appearance(color = "#6d7579", metalness = 85, roughness = 33)

fuelDischargeProfileSketch = sketch(on = XY) {
  tube = circle(start = [var 170mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([tube.center, ORIGIN])
  horizontal([tube.center, tube.start])
  diameter(tube) == 340mm
}
fuelDischargeProfile = region(segments = [fuelDischargeProfileSketch.tube])
fuelDischargeProfileBSketch = sketch(on = XY) {
  tube = circle(start = [var 170mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([tube.center, ORIGIN])
  horizontal([tube.center, tube.start])
  diameter(tube) == 340mm
}
fuelDischargeProfileB = region(segments = [fuelDischargeProfileBSketch.tube])
fuelDischargePathASketch = sketch(on = offsetPlane(YZ, offset = 300mm)) {
  pumpDrop = line(start = [var 250mm, var -790mm], end = [var 250mm, var -1090mm])
  lowerElbow = arc(start = [var 250mm, var -1090mm], end = [var 550mm, var -1390mm], center = [var 550mm, var -1090mm])
  crossover = line(start = [var 550mm, var -1390mm], end = [var 1600mm, var -1390mm])
  returnElbow = arc(start = [var 1600mm, var -1390mm], end = [var 1900mm, var -1090mm], center = [var 1600mm, var -1090mm])
  chamberRise = line(start = [var 1900mm, var -1090mm], end = [var 1900mm, var -920mm])
  coincident([pumpDrop.end, lowerElbow.start])
  coincident([lowerElbow.end, crossover.start])
  coincident([crossover.end, returnElbow.start])
  coincident([returnElbow.end, chamberRise.start])
  tangent([pumpDrop, lowerElbow])
  tangent([lowerElbow, crossover])
  tangent([crossover, returnElbow])
  tangent([returnElbow, chamberRise])
  vertical(pumpDrop)
  horizontal(crossover)
  vertical(chamberRise)
  horizontalDistance([ORIGIN, pumpDrop.start]) == 250mm
  verticalDistance([ORIGIN, pumpDrop.start]) == -790mm
  distance([pumpDrop.start, pumpDrop.end]) == 300mm
  horizontalDistance([ORIGIN, lowerElbow.center]) == 550mm
  verticalDistance([ORIGIN, lowerElbow.center]) == -1090mm
  horizontalDistance([ORIGIN, lowerElbow.end]) == 550mm
  verticalDistance([ORIGIN, lowerElbow.end]) == -1390mm
  distance([crossover.start, crossover.end]) == 1050mm
  horizontalDistance([ORIGIN, returnElbow.center]) == 1600mm
  verticalDistance([ORIGIN, returnElbow.center]) == -1090mm
  horizontalDistance([ORIGIN, returnElbow.end]) == 1900mm
  verticalDistance([ORIGIN, returnElbow.end]) == -1090mm
  distance([chamberRise.start, chamberRise.end]) == 170mm
}
fuelDischargePathBSketch = sketch(on = offsetPlane(XZ, offset = -1900mm)) {
  finalElbow = arc(start = [var 300mm, var -920mm], end = [var 600mm, var -620mm], center = [var 600mm, var -920mm])
  manifoldRun = line(start = [var 600mm, var -620mm], end = [var 715mm, var -620mm])
  coincident([finalElbow.end, manifoldRun.start])
  tangent([finalElbow, manifoldRun])
  horizontal(manifoldRun)
  horizontalDistance([ORIGIN, finalElbow.start]) == 300mm
  verticalDistance([ORIGIN, finalElbow.start]) == -920mm
  horizontalDistance([ORIGIN, finalElbow.center]) == 600mm
  verticalDistance([ORIGIN, finalElbow.center]) == -920mm
  horizontalDistance([ORIGIN, finalElbow.end]) == 600mm
  verticalDistance([ORIGIN, finalElbow.end]) == -620mm
  distance([manifoldRun.start, manifoldRun.end]) == 115mm
}
fuelDischargeDuctA = sweep(
  fuelDischargeProfile,
  path = [
    fuelDischargePathASketch.pumpDrop,
    fuelDischargePathASketch.lowerElbow,
    fuelDischargePathASketch.crossover,
    fuelDischargePathASketch.returnElbow,
    fuelDischargePathASketch.chamberRise
  ],
  translateProfileToPath = true,
  orientProfilePerpendicular = true,
  version = 2,
)
  |> appearance(color = "#959da0", metalness = 87, roughness = 32)
fuelDischargeDuctB = sweep(
  fuelDischargeProfileB,
  path = [
    fuelDischargePathBSketch.finalElbow,
    fuelDischargePathBSketch.manifoldRun
  ],
  translateProfileToPath = true,
  orientProfilePerpendicular = true,
  version = 2,
)
  |> appearance(color = "#959da0", metalness = 87, roughness = 32)

