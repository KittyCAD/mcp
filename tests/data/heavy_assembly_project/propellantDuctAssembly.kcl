loxFeedProfileSketchHidden = hide(loxFeedProfileSketch)
loxFeedPathSketchHidden = hide(loxFeedPathSketch)
loxReducerStartSketchHidden = hide(loxReducerStartSketch)
loxReducerMidSketchHidden = hide(loxReducerMidSketch)
