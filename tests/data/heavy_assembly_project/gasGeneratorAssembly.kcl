  |> scale(
       x = 310,
       y = 180,
       z = 180,
       global = true,
     )
  |> translate(
       x = -425mm,
       y = -300mm,
       z = 305mm,
       global = true,
     )
  |> appearance(color = "#90999c", metalness = 87, roughness = 30)
loxServiceFlange = clone(unitRingX)
  |> scale(
       x = 78,
       y = 265,
       z = 265,
       global = true,
     )
  |> translate(
       x = -590mm,
       y = -300mm,
       z = 305mm,
       global = true,
     )
  |> appearance(color = "#c0c5c6", metalness = 92, roughness = 22)
fuelServiceBoss = clone(unitCylinderX)
  |> scale(
       x = 310,
       y = 170,
       z = 170,
       global = true,
     )
  |> translate(
       x = 425mm,
       y = -300mm,
       z = 305mm,
       global = true,
     )
  |> appearance(color = "#a27d5b", metalness = 79, roughness = 38)
fuelServiceFlange = clone(unitRingX)
  |> scale(
       x = 78,
       y = 250,
       z = 250,
       global = true,
     )
  |> translate(
       x = 590mm,
       y = -300mm,
       z = 305mm,
       global = true,
     )
  |> appearance(color = "#c1ae92", metalness = 85, roughness = 30)

igniterBossUpper = clone(unitCylinderX)
  |> scale(
       x = 230,
       y = 105,
       z = 105,
       global = true,
     )
  |> translate(
       x = 285mm,
       y = 35mm,
       z = 145mm,
       global = true,
     )
  |> appearance(color = "#666e72", metalness = 84, roughness = 34)
igniterBossLower = clone(igniterBossUpper)
  |> translate(z = -290mm, global = true)
igniterCapUpper = clone(unitCylinderX)
  |> scale(
       x = 58,
       y = 155,
       z = 155,
       global = true,
     )
  |> translate(
       x = 410mm,
       y = 35mm,
       z = 145mm,
       global = true,
