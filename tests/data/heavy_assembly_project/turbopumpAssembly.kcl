// F-1 turbopump assembly
// Coupled oxidizer pump, fuel pump, turbine, shaft line, volutes, covers, and mounting cradle.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock, unitCylinderX, unitCylinderY, unitCylinderZ, unitRingX, unitRingY, unitRingZ from "primitives.kcl"

