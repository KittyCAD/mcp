  |> rotate(axis = Y, angle = -28deg, global = true)
  |> translate(
       x = -690mm,
       y = -170mm,
       z = 820mm,
       global = true,
     )
  |> appearance(color = "#4c555a", metalness = 80, roughness = 38)

loxTransferClamp = clone(unitRingY)
  |> scale(
       x = 735,
       y = 72,
       z = 735,
       global = true,
     )
  |> translate(
       x = -500mm,
       y = 610mm,
       z = 35mm,
       global = true,
     )
  |> appearance(color = "#a38b70", metalness = 82, roughness = 35)
loxTransferBoltSeed = clone(unitCylinderY)
  |> scale(
       x = 42,
       y = 110,
       z = 42,
       global = true,
     )
  |> translate(
       x = -500mm,
       y = 610mm,
       z = 355mm,
       global = true,
